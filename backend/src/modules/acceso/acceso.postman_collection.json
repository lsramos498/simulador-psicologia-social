            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombres\": \"Docente\",\n  \"apellidos\": \"Demostración\",\n  \"correo\": \"{{docenteCorreo}}\",\n  \"contrasena\": \"{{docenteContrasena}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Correo y contraseña únicos para cada ejecución.",
                  "pm.collectionVariables.set('docenteCorreo', `docente.demo.${Date.now()}@unihumboldt.edu.co`);",
                  "pm.collectionVariables.set('docenteContrasena', `Demo-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 201', () => pm.response.to.have.status(201));",
                  "pm.test('el docente tiene el rol Docente', () => pm.expect(pm.response.json().data.roles).to.eql(['Docente']));",
                  "pm.test('no devuelve la contraseña', () => pm.expect(pm.response.text()).to.not.include(pm.collectionVariables.get('docenteContrasena')));"
                ]
              }
            }
          ]
        },
