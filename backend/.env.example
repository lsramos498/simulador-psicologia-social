PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=proyecto_nuclear
DB_USER=lumina_app
DB_PASSWORD=replace_with_local_password
CODIGO_AUTORIZACION_SECRETO=replace_with_long_random_secret_min_32_chars
JWT_SECRETO=replace_with_long_random_secret_min_32_chars
JWT_EXPIRACION=1h
URL_ACCESO=http://localhost:5173
# Solo para demos locales: true muestra el código del estudiante en pantalla al pedirlo.
# Nunca en un servidor real: cualquiera que sepa el correo de un convocado entraría como él.
ACCESO_CODIGO_EN_PANTALLA=false
# RF-22 ingreso tardío: fracción del tiempo límite de la actividad, contada desde su fechaInicio,
# después de la cual el estudiante ya no puede iniciar su participación. 0.5 = la mitad. 0 = desactivada.
INGRESO_TARDIO_FRACCION=0.5

ADMIN_CORREO=admin@unihumboldt.edu.co
ADMIN_NOMBRES=replace_with_names
ADMIN_APELLIDOS=replace_with_last_names
ADMIN_CONTRASENA=replace_with_strong_password

# Remitente del SISTEMA Lumina (no el docente ni el estudiante).
# ethereal = preview local | smtp = Gmail real a cada correoInstitucional
# Cuenta del proyecto + app password: https://myaccount.google.com/apppasswords
SMTP_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=luminasimulador@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=Lumina <luminasimulador@gmail.com>
