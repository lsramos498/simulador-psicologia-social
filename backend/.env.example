PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=proyecto_nuclear
DB_USER=lumina_app
DB_PASSWORD=replace_with_local_password
CODIGO_AUTORIZACION_SECRETO=replace_with_long_random_secret_min_32_chars
JWT_SECRETO=replace_with_long_random_secret_min_32_chars
JWT_EXPIRACION=1h
URL_ACCESO=http://localhost:5173
# Demos locales: true muestra el código en pantalla al pedirlo.
# Con SMTP_MODE=demo|pantalla también se muestra (sin depender de esta bandera).
# Nunca true en un servidor real con usuarios ajenos.
ACCESO_CODIGO_EN_PANTALLA=true
# RF-22 ingreso tardío: fracción del tiempo límite de la actividad, contada desde su fechaInicio,
# después de la cual el estudiante ya no puede iniciar su participación. 0.5 = la mitad. 0 = desactivada.
INGRESO_TARDIO_FRACCION=0.5

ADMIN_CORREO=admin@unihumboldt.edu.co
ADMIN_NOMBRES=replace_with_names
ADMIN_APELLIDOS=replace_with_last_names
ADMIN_CONTRASENA=replace_with_strong_password

# Correo del SISTEMA (institucional). No uses Gmail personal del docente.
# From = SMTP_FROM (Lumina). Reply-To = correoInstitucional del docente que programa.
# demo|pantalla = código en pantalla (sin SMTP).
# smtp = relay institucional / Resend / similar (SMTP_USER + SMTP_PASS del sistema).
SMTP_MODE=demo
SMTP_HOST=smtp.institucion.edu.co
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@institucion.edu.co
SMTP_PASS=replace_with_system_smtp_secret
SMTP_FROM=Lumina <noreply@institucion.edu.co>
URL_ACCESO=http://localhost:5173
